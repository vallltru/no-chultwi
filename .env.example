# ==========================================
# No-Chultwi 배포 환경 변수 템플릿 (.env.example)
# 이 파일을 복사하여 '.env' 파일을 만든 후 실제 비밀번호를 설정하세요.
# ==========================================

# MySQL Database 설정
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=nochultwidb
MYSQL_USER=nochultwi_user
MYSQL_PASSWORD=your_secure_user_password_here

# 백엔드 서버 포트
SERVER_PORT=8080

# CORS 허용 도메인 (필요시 쉼표로 구분, 예: http://localhost:3000,http://your-domain.com)
CORS_ALLOWED_ORIGINS=*
