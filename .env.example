# ==========================================
# No-Chultwi 배포 환경 변수 템플릿 (.env.example)
# 복사하여 '.env' 파일을 만든 후 실제 값을 설정하세요.
# ==========================================

# Docker Hub 이미지 태그 (예: myusername/nochultwi-backend:latest)
DOCKER_IMAGE=your_dockerhub_username/nochultwi-backend:latest

# MySQL Database 설정
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=nochultwidb
MYSQL_USER=nochultwi_user
MYSQL_PASSWORD=your_secure_user_password_here

# 백엔드 서버 포트
SERVER_PORT=8080

# CORS 허용 도메인 (필요시 쉼표로 구분, 와일드카드 * 사용 불가)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# 서울시립대 WISE 시간표 OpenAPI 인증키
SCHOOL_UOS_API_KEY=

# AI 얼굴인식 추론 서버 연동 설정 (기본 비활성화: Stub 어댑터 동작)
AI_FACE_ENABLED=false
AI_FACE_SERVER_URL=http://localhost:8000
AI_SIMILARITY_THRESHOLD=0.42
AI_INTERNAL_SECRET=
